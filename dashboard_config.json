        "wind_measurements": "Wind speed and direction",
        "barometric_pressure": "Barometric pressure"
      },
      "key_required": false,
      "free": true
    },
    "solunar_org": {
      "endpoint": "https://api.solunar.org/solunar/lat,lon,date,tz",
