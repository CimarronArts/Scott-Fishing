      "forecast_days": 8,
      "free": true
    },
    "noaa_tides": {
      "endpoint": "https://tidesandcurrents.noaa.gov/api/",
      "station_id": "9414290",
      "parameters": {
        "predictions": "Tide predictions",
        "water_level": "Water level observations",
        "currents": "Current data",
        "water_temperature": "Water temperature"
      },
      "key_required": false,
      "free": true
    },
    "noaa_weather": {
      "endpoint": "https://api.weather.gov",
      "parameters": {
        "marine_forecasts": "Marine weather forecasts",
        "small_craft_advisory": "Small craft advisories",
        "weather_conditions": "General weather conditions",
        "barometric_pressure": "Barometric pressure"
      },
      "key_required": false,
      "free": true
    },
    "noaa_ndbc_buoy": {
      "buoy_id": "46012",
