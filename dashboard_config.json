      "parameters": {
        "wave_height": "Wave height of significant mean waves",
        "wave_direction": "Mean direction of waves",
        "wave_period": "Period between waves",
        "wind_wave_height": "Wind wave height",
        "swell_wave_height": "Swell wave height",
        "ocean_current_velocity": "Ocean current velocity",
